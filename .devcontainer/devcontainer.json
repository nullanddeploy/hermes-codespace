{
  "name": "Hermes Agent",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "postCreateCommand": "curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash; pip install 'hermes-agent[web]'",
  "postStartCommand": "nohup /home/codespace/.local/bin/hermes dashboard > /tmp/dashboard.log 2>&1 & nohup /home/codespace/.local/bin/hermes gateway > /tmp/gateway.log 2>&1 &",
  "forwardPorts": [9119],
  "portsAttributes": {
    "9119": {
      "label": "Hermes Dashboard",
      "onAutoForward": "notify"
    }
  }
}
